msgstr "ویرایش محل نمایش"

msgid "All locations"
msgstr "همه محل‌های نمایش"

msgid "%d service was duplicated."
msgid_plural "%d services were duplicated."
msgstr[0] "%d سرویس تکثیر شد."
msgstr[1] "%d سرویس تکثیر شدند."

msgid "%(count)d service was moved to “%(name)s”."
msgid_plural "%(count)d services were moved to “%(name)s”."
msgstr[0] "%(count)d سرویس به «%(name)s» منتقل شد."
msgstr[1] "%(count)d سرویس به «%(name)s» منتقل شدند."

