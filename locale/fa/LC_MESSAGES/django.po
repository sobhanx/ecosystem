msgid "Dangerous actions"
msgstr "عملیات حساس"

msgid "Order"
msgstr "ترتیب"

msgid "Delete %(name)s"
msgstr "حذف %(name)s"

msgid "Drag to reorder"
msgstr "کشیدن برای تغییر ترتیب"

